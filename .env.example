# Public origin used for absolute URLs (Open Graph, robots, sitemap).
# Optional on Vercel: the production domain is used when unset.
NEXT_PUBLIC_SITE_URL=https://micro-rally.example.com

# Online saves. Add the Upstash Redis (Vercel KV) integration in the Vercel
# dashboard and these are injected automatically. Without them, Vercel
# deployments answer 503 on /api/games and saves stay on the player's device.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Self-hosting with the file store (ignored when Redis is configured).
# MICRO_RALLY_SAVE_DIR=/var/lib/micro-rally/games
