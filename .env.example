# Public origin used for absolute URLs (Open Graph, robots, sitemap).
# Optional on Vercel: the production domain is used when unset.
NEXT_PUBLIC_SITE_URL=https://micro-rally.example.com

# Online saves: a Supabase project with the `games` table from
# supabase/migrations. The Vercel Supabase integration injects these; otherwise
# copy them from Project Settings → API. The service-role key is secret and
# server-only. Without them, Vercel deployments answer 503 on /api/games and
# saves stay on the player's device.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Self-hosting with the file store (ignored when Supabase is configured).
# MICRO_RALLY_SAVE_DIR=/var/lib/micro-rally/games
